<SerginAggregateDetailView TitleText="UserTexts.Singular" Trail="Trail" Problem="problem" Ready="@(user is not null)" Actions="Actions"
                           FieldsTitleData="@user?.UserName">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
        <SerginCopyLinkButton />
    </HeaderActions>
    <Fields>
        @if (user is not null)
        {
            <SerginDetailField LabelText="UserTexts.UserName.Label" Value="@user.UserName" />
            <SerginDetailField LabelText="UserUiTexts.Identifier" Value="@user.Id.ToString()" />
        }
    </Fields>
    <Entities>
        <UserAssignmentsView @ref="assignments" UserId="Id" />
    </Entities>
</SerginAggregateDetailView>
