@* Two embedded sections of the user detail view: the assignments with the assign form, and what they add up to. *@
<SerginEntityListView TitleText="AssignmentUiTexts.Title" Count="assignments.Count">
    @if (assignments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-2">@Localizer.Text(AssignmentUiTexts.Empty)</MudText>
    }
    else
    {
        <MudSimpleTable Hover="true" Dense="true">
            <thead>
                <tr>
                    <th>@Localizer.Text(AssignmentTexts.RoleId.Label)</th>
                    <th>@Localizer.Text(AssignmentTexts.ScopeId.Label)</th>
                    <th>@Localizer.Text(AssignmentUiTexts.Covers)</th>
                    <th>@Localizer.Text(AssignmentUiTexts.Valid)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserAssignmentItem assignment in assignments)
                {
                    <tr>
                        <td><MudLink Href="@($"/ua/roles/{assignment.RoleId}")">@assignment.RoleName</MudLink></td>
                        <td><MudLink Href="@($"/ua/scopes/{assignment.ScopeId}")">@assignment.ScopeName</MudLink></td>
                        <td>@Covers(assignment.IncludeSubtree)</td>
                        <td>@Period(assignment)</td>
                        <td>
                            @if (assignment.RevokedAtUtc is null)
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Disabled="busy"
                                           OnClick="@(() => RevokeAsync(assignment.Id))">@Localizer.Text(AssignmentUiTexts.Revoke)</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">@Localizer.Text(AssignmentUiTexts.Revoked)</MudText>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    <MudCard Outlined="true" Class="mt-4">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1">@Localizer.Text(AssignmentUiTexts.AssignTitle)</MudText>
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" Value="model.ScopeId" ValueChanged="OnScopeChangedAsync" Label="@Localizer.Text(AssignmentTexts.ScopeId.Label)">
                @foreach (ScopeTreeItem scope in scopes)
                {
                    <MudSelectItem T="Guid" Value="@scope.Id">@scope.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" @bind-Value="model.RoleId" Label="@Localizer.Text(AssignmentTexts.RoleId.Label)" Disabled="@(model.ScopeId == Guid.Empty)">
                @foreach (AssignableRoleItem role in roles)
                {
                    <MudSelectItem T="Guid" Value="@role.Id">@RoleOption(role)</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="model.IncludeSubtree" Color="Color.Primary" Label="@Localizer.Text(AssignmentTexts.IncludeSubtree.Label)" />
            <MudDatePicker Culture="@Formatter.Culture" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="model.ValidFromUtc"
                           Label="@Localizer.Text(AssignmentTexts.ValidFromUtc.Label)" HelperText="@OptionalHint" Clearable="true" />
            <MudDatePicker Culture="@Formatter.Culture" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="model.ValidUntilUtc"
                           Label="@Localizer.Text(AssignmentTexts.ValidUntilUtc.Label)" HelperText="@OptionalHint" Clearable="true" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(busy || model.RoleId == Guid.Empty)" OnClick="AssignAsync">@Localizer.Text(AssignmentUiTexts.Assign)</MudButton>
        </MudCardActions>
    </MudCard>
</SerginEntityListView>

<SerginEntityListView TitleText="AssignmentUiTexts.EffectiveTitle" Count="effective.Count">
    @if (effective.Count == 0)
    {
        <MudText Typo="Typo.body2">@Localizer.Text(AssignmentUiTexts.NoPermissions)</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr>
                    <th>@Localizer.Text(AssignmentTexts.ScopeId.Label)</th>
                    <th>@Localizer.Text(AssignmentUiTexts.Covers)</th>
                    <th>@Localizer.Text(AssignmentUiTexts.Permissions)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (EffectivePermissionItem item in effective)
                {
                    <tr>
                        <td>@item.ScopeName</td>
                        <td>@Covers(item.IncludeSubtree)</td>
                        <td>@PermissionsOf(item)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SerginEntityListView>
