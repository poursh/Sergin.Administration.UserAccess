<SerginAggregateDetailView TitleText="RoleTexts.Singular" Trail="Trail" Problem="problem" Ready="@(role is not null)" Actions="Actions"
                           FieldsTitleData="@role?.Name">
    <HeaderActions>
        <SerginReloadButton OnReload="LoadAsync" />
        <SerginCopyLinkButton />
    </HeaderActions>
    <Fields>
        @if (role is not null)
        {
            <SerginDetailField LabelText="RoleTexts.Name.Label" Value="@role.Name" />
            <SerginDetailField LabelText="RoleTexts.OwnedBy">
                <MudLink Href="@($"/ua/scopes/{role.OwnerScopeId}")">@role.OwnerScopeName</MudLink>
            </SerginDetailField>
            <SerginDetailField LabelText="RoleTexts.IsInheritable.Label">
                <MudSwitch T="bool" Value="role.IsInheritable" ValueChanged="SetInheritableAsync" Color="Color.Primary"
                           Disabled="busy" Label="@Localizer.Text(RoleTexts.InheritableOnDetail)" />
            </SerginDetailField>
        }
    </Fields>
    <Entities>
        @if (role is not null)
        {
            <MudForm @ref="form" Model="model" Validation="@validation" @bind-IsValid="isValid"
                     SuppressImplicitSubmission="false" onsubmit="@OnRename">
                <MudCard Outlined="true" Class="mb-4">
                    <MudCardContent>
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.Name" Label="@Localizer.Text(RoleTexts.Name.Label)" For="@(() => model.Name)" Immediate="true" />
                        <MudCheckBox T="bool" @bind-Value="cascade" Label="@Localizer.Text(RoleTexts.Cascade.Label)" />
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                   Color="Color.Primary" Disabled="@(busy || !isValid)">@Localizer.Text(CommonTexts.Rename)</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudForm>

            <SerginEntityListView TitleText="RoleTexts.Permissions.Label" Count="role.Permissions.Count">
                @foreach (PermissionDefinition definition in GrantedDefined)
                {
                    <MudChip T="string" Value="@definition.Permission.Value" OnClose="@(_ => RevokeAsync(definition.Permission.Value))">@PermissionLabels.Of(Catalog, Localizer, definition)</MudChip>
                }
                @if (GrantedUnknown.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">@Localizer.Text(RoleTexts.Unknown)</MudText>
                    @foreach (string permission in GrantedUnknown)
                    {
                        <MudChip T="string" Value="@permission" OnClose="@(_ => RevokeAsync(permission))">@permission</MudChip>
                    }
                }
                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="permissionToGrant" ToStringFunc="@LabelOf" Label="@Localizer.Text(RoleTexts.AddPermission)">
                    @foreach (PermissionPickerSection picker in PickerSections)
                    {
                        <PermissionSubheader>@picker.Title</PermissionSubheader>
                        @foreach (PermissionCatalogGroup group in picker.Groups)
                        {
                            <PermissionSubheader Class="pl-6">@Localizer.Text(group.Title)</PermissionSubheader>
                            @foreach (PermissionDefinition definition in group.Permissions.Where(definition => !IsGranted(definition)))
                            {
                                <MudSelectItem T="string" Value="@definition.Permission.Value">
                                    @PermissionLabels.Of(Catalog, Localizer, definition) <MudText Typo="Typo.caption">@definition.Permission.Value</MudText>
                                </MudSelectItem>
                            }
                        }
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                           Disabled="@(busy || string.IsNullOrEmpty(permissionToGrant))" OnClick="GrantAsync">@Localizer.Text(CommonTexts.Add)</MudButton>
            </SerginEntityListView>
        }
    </Entities>
</SerginAggregateDetailView>
