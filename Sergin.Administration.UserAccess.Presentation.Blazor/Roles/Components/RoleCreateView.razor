<SerginFormView TitleText="RoleTexts.New" Trail="Trail"
                Model="model" Validation="validation" OnSubmit="OnSubmit" Submitting="submitting" SubmitLabelText="CommonTexts.Create" CancelHref="@($"/ua/scopes/{ScopeId}")">
    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.Name" Label="@Localizer.Text(RoleTexts.Name.Label)" For="@(() => model.Name)" Immediate="true" />
    <MudSwitch T="bool" @bind-Value="model.IsInheritable" Color="Color.Primary"
               Label="@Localizer.Text(RoleTexts.InheritableOnCreate)" />
    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="string" MultiSelection="true" ToStringFunc="@LabelOf" MultiSelectionTextFunc="@SelectedText" @bind-SelectedValues="model.Permissions" Label="@Localizer.Text(RoleTexts.Permissions.Label)"
               For="@(() => model.Name)">
        @foreach (PermissionPickerSection picker in PickerSections)
        {
            <PermissionSubheader>@picker.Title</PermissionSubheader>
            @foreach (PermissionCatalogGroup group in picker.Groups)
            {
                <PermissionSubheader Class="pl-6">@Localizer.Text(group.Title)</PermissionSubheader>
                @foreach (PermissionDefinition definition in group.Permissions)
                {
                    <MudSelectItem T="string" Value="@definition.Permission.Value">
                        @PermissionLabels.Of(Catalog, Localizer, definition) <MudText Typo="Typo.caption">@definition.Permission.Value</MudText>
                    </MudSelectItem>
                }
            }
        }
    </MudSelect>
</SerginFormView>
