@using Sergin.Administration.UserAccess.Application.Contracts.Scopes.Commands.GetOne
@if (Context.Record is ScopeQueryResponse)
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-2">@Localizer.Text(ScopeUiTexts.RolesUsableHere)</MudText>
    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr>
                <th>@Localizer.Text(ScopeUiTexts.Role)</th>
                <th>@Localizer.Text(ScopeUiTexts.OwnedBy)</th>
                <th>@Localizer.Text(ScopeUiTexts.Inheritable)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AssignableRoleItem role in roles)
            {
                <tr>
                    <td><MudLink Href="@($"/ua/scopes/{role.OwnerScopeId}/roles/{role.Id}")">@role.Name</MudLink></td>
                    <td>@role.OwnerScopeName</td>
                    <td>@Localizer.Text(role.IsInheritable ? ScopeUiTexts.Yes : ScopeUiTexts.No)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}
