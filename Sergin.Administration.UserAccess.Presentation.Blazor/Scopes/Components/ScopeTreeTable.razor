@if (ordered.Count == 0)
{
    <MudText Typo="Typo.body2">@Localizer.Text(EmptyMessage)</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr>
                <th>@Localizer.Text(ScopeTexts.Name.Label)</th>
                <th>@Localizer.Text(ScopeUiTexts.Level)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ScopeTreeItem scope in ordered)
            {
                <tr>
                    <td style="@Indent(scope)"><MudLink Href="@($"/ua/scopes/{scope.Id}")">@scope.Name</MudLink></td>
                    <td>@Formatter.Number(scope.Depth)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}
