@* Two embedded sections of the user detail view: the assignments with the assign form, and what they add up to. *@
<SerginEntityListView Title="Assignments" Count="assignments.Count">
    @if (assignments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-2">No assignments yet.</MudText>
    }
    else
    {
        <MudSimpleTable Hover="true" Dense="true">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Scope</th>
                    <th>Covers</th>
                    <th>Valid</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserAssignmentItem assignment in assignments)
                {
                    <tr>
                        <td><MudLink Href="@($"/ua/roles/{assignment.RoleId}")">@assignment.RoleName</MudLink></td>
                        <td><MudLink Href="@($"/ua/scopes/{assignment.ScopeId}")">@assignment.ScopeName</MudLink></td>
                        <td>@(assignment.IncludeSubtree ? "Scope and below" : "This scope only")</td>
                        <td>@Period(assignment)</td>
                        <td>
                            @if (assignment.RevokedAtUtc is null)
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Disabled="busy"
                                           OnClick="@(() => RevokeAsync(assignment.Id))">Revoke</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">Revoked</MudText>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    <MudCard Outlined="true" Class="mt-4">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1">Assign a role</MudText>
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" Value="model.ScopeId" ValueChanged="OnScopeChangedAsync" Label="Scope">
                @foreach (ScopeTreeItem scope in scopes)
                {
                    <MudSelectItem T="Guid" Value="@scope.Id">@scope.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" @bind-Value="model.RoleId" Label="Role" Disabled="@(model.ScopeId == Guid.Empty)">
                @foreach (AssignableRoleItem role in roles)
                {
                    <MudSelectItem T="Guid" Value="@role.Id">@role.Name (@role.OwnerScopeName)</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="model.IncludeSubtree" Color="Color.Primary" Label="Also every scope below" />
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="model.ValidFromUtc" Label="Valid from (optional)" Clearable="true" />
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="model.ValidUntilUtc" Label="Valid until (optional)" Clearable="true" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(busy || model.RoleId == Guid.Empty)" OnClick="AssignAsync">Assign</MudButton>
        </MudCardActions>
    </MudCard>
</SerginEntityListView>

<SerginEntityListView Title="Effective permissions" Count="effective.Count">
    @if (effective.Count == 0)
    {
        <MudText Typo="Typo.body2">No permissions held.</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr>
                    <th>Scope</th>
                    <th>Covers</th>
                    <th>Permissions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (EffectivePermissionItem item in effective)
                {
                    <tr>
                        <td>@item.ScopeName</td>
                        <td>@(item.IncludeSubtree ? "Scope and below" : "This scope only")</td>
                        <td>@string.Join(", ", item.Permissions)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SerginEntityListView>
