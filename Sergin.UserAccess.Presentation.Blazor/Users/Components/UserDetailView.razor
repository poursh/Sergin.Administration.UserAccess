<SerginAggregateDetailView Title="User" Trail="Trail" Problem="problem" Ready="@(user is not null)" Actions="Actions"
                           FieldsTitle="@user?.UserName">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
        <SerginCopyLinkButton />
    </HeaderActions>
    <Fields>
        @if (user is not null)
        {
            <SerginDetailField Label="User name" Value="@user.UserName" />
            <SerginDetailField Label="Id" Value="@user.Id.ToString()" />
        }
    </Fields>
    <Entities>
        <UserAssignmentsView @ref="assignments" UserId="Id" />
    </Entities>
</SerginAggregateDetailView>
